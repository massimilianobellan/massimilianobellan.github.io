---
import { Doodlelot as DoodlelotCanvas } from 'src/components/Doodletlot/Doodlelot'
import Layout from 'src/layouts/Layout.astro'
---

<Layout>
  <div class="main">
    <div class="title">Doodlelot</div>
    <DoodlelotCanvas client:load />
  </div>
</Layout>

<style>
  .main {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }

  .title {
    font-size: 2rem;
  }
</style>
